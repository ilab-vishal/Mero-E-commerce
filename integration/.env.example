# General App Settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Shopify Credentials
SHOPIFY_STORE_URL=your_store.myshopify.com
SHOPIFY_API_VERSION=2026-01
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_client_secret_here
SHOPIFY_ACCESS_TOKEN=your_access_token_here
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# WooCommerce Credentials
WOOCOMMERCE_STORE_URL=https://your-woo-store.com
WOOCOMMERCE_API_VERSION=wc/v3
WOOCOMMERCE_CONSUMER_KEY=your_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=your_consumer_secret_here
WOOCOMMERCE_WEBHOOK_SECRET=your_webhook_secret_here

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ES_INDEX_NAME=products_unified
ELASTIC_USER=elastic
ELASTIC_PASS=changeme
KIBANA_ES_TOKEN=

# Ngrok Configuration
NGROK_AUTHENTICATION=
NGROK_URL=
